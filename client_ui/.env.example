# Base URL for your hg backend API (server-to-server not required for the UI).
NEXT_PUBLIC_HG_API_BASE=http://localhost:8080

# Optional. If your backend supports server-sent events for streaming tokens/events.
NEXT_PUBLIC_HG_SSE_URL=http://localhost:8080/sse

# Optional. If your backend supports websocket events.
NEXT_PUBLIC_HG_WS_URL=ws://localhost:8080/ws

# If true, the UI will use Next.js mock endpoints at /api/mock for demo mode.
