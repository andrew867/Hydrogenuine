# Hydrogenuine Agent Zero — Docker Environment Example
# Copy to .env and customize as needed.
# Do NOT put real secrets here. This file is committed to the repo.

# --- Mode ---
HG_MODE=fixture
HG_RUNTIME_PROFILE=fixture

# --- Data Directories (inside container) ---
HG_PROOF_DIR=/data/proofs
HG_REPORT_DIR=/data/reports
HG_STATE_DIR=/data/state
HG_DB_URL=sqlite:////data/state/hydrogenuine.sqlite3

# --- Safety Defaults ---
HG_DISABLE_REMOTE_PROVIDERS=true
HG_DISABLE_LIVE_EFFECTS=true
HG_REQUIRE_OPERATOR_REVIEW=true
HG_SOCIAL_LIVE_PUBLISH=false
HG_PROVIDER_LOCAL_OPENVINO_CONFIGURED=false
HG_COGNITIVE_SOAK_ACTIVE=1

# --- LM Studio (lmstudio profile) ---
# From Docker container, use host.docker.internal to reach host LM Studio.
# For network LM Studio, use a LAN or Tailscale IP.
HG_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
HG_LMSTUDIO_SELECTED_MODEL=google/gemma-4-e4b
HG_LMSTUDIO_ALLOWED_MODELS=google/gemma-4-e4b,gemma-3-4b-it,qwen2.5-7b-instruct,qwen2.5-coder-7b-instruct,qwen2.5-coder-3b-instruct
HG_LMSTUDIO_FORBIDDEN_PATTERNS=deepseek,cybersecurity,offensive,uncensored,30b,qwen3-coder-30b

# --- OpenVINO (openvino profile) ---
HG_OPENVINO_MODEL_DIR=/models/openvino
HG_ALLOW_MODEL_DOWNLOADS=false
