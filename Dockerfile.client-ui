# HG Client UI (Next.js). Multi-stage: build then run standalone server (minimal deps).
FROM node:20-bookworm-slim AS builder

WORKDIR /workspace

ARG NEXT_PUBLIC_HG_API_BASE=http://localhost:8080
ARG NEXT_PUBLIC_HG_SSE_URL=
ARG NEXT_PUBLIC_HG_WS_URL=
ARG NEXT_PUBLIC_DEMO_OPERATOR_KEY=
ENV NEXT_PUBLIC_HG_API_BASE=$NEXT_PUBLIC_HG_API_BASE
ENV NEXT_PUBLIC_HG_SSE_URL=$NEXT_PUBLIC_HG_SSE_URL
ENV NEXT_PUBLIC_HG_WS_URL=$NEXT_PUBLIC_HG_WS_URL
ENV NEXT_PUBLIC_DEMO_OPERATOR_KEY=$NEXT_PUBLIC_DEMO_OPERATOR_KEY

COPY ui/hg_ui_kit/package.json ui/hg_ui_kit/package-lock.json* ./ui/hg_ui_kit/
WORKDIR /workspace/ui/hg_ui_kit
RUN npm ci --ignore-scripts 2>/dev/null || npm install --ignore-scripts
COPY ui/hg_ui_kit .
RUN npm run build

COPY client_ui/package.json client_ui/package-lock.json* /workspace/client_ui/
WORKDIR /workspace/client_ui
RUN npm ci 2>/dev/null || npm install

COPY client_ui .
RUN npm run build

FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3001

COPY --from=builder /workspace/client_ui/.next/standalone ./
COPY --from=builder /workspace/client_ui/.next/static ./.next/static
COPY --from=builder /workspace/client_ui/public ./public

EXPOSE 3001
CMD ["node", "server.js"]
