# Hydrogenuine Community local defaults.
# Copy to .env for local overrides. Do not commit real secrets.

HG_COMMUNITY_DATA_DIR=.hg_community
HG_CONFIG_PATH=.hg_community/config.json
HG_GATEWAY_AUTH_MODE=local-no-key
HG_GATEWAY_STORE=sqlite
HG_GATEWAY_DB_PATH=.hg_community/gateway.sqlite3
PYTHONDONTWRITEBYTECODE=1

# Configure models with `hg init`. Provider secrets remain in your shell and
# are referenced by environment-variable name; they are never written here.
