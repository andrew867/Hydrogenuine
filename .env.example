# Hydrogenuine Community local defaults.
# Copy to .env for local overrides. Do not commit real secrets.

HG_GATEWAY_API_KEY=oss-demo-key
HG_COMMUNITY_DATA_DIR=.hg_community
HG_GATEWAY_STORE=memory
PYTHONDONTWRITEBYTECODE=1

# Optional model endpoint. Leave unset for deterministic offline stub mode.
# HG_MODEL_PROVIDER=openai-compatible
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=local-model
